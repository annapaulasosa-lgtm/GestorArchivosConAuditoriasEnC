#include <time.h>
#include <sys/stat.h>  //revisar
#include <errno.h> //revisar
#include <unistd.h> //revisar

void inciarPapelera(void){
    if (mkdir(".papelera") == -1 && errno != EEXIST) {
        perror("No se pudo crear la papelera");
    }
}
